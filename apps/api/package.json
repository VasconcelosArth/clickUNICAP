{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do ClickUNICAP (NestJS + Drizzle). Ver docs/04-backend-guia.md",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,alias,node -c blue,gray,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --watch\" \"node --watch-path=dist --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/core/database/seed.ts",
    "db:seed:demo": "tsx src/core/database/seed-demo.ts"
  },
  "dependencies": {
    "@clickunicap/shared": "workspace:*",
    "@nestjs/common": "^11.0.7",
    "@nestjs/core": "^11.0.7",
    "@nestjs/event-emitter": "^3",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "argon2": "^0.41",
    "cookie-parser": "^1.4",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.7",
    "@types/cookie-parser": "^1.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.10",
    "tsx": "^4",
    "typescript": "^5.7.2"
  }
}
