# Copie para .env:  cp .env.example .env
# NUNCA commite o .env. Valores abaixo são só para desenvolvimento local.

# ---------- Postgres (docker-compose) ----------
POSTGRES_USER=clickunicap
POSTGRES_PASSWORD=clickunicap
POSTGRES_DB=clickunicap
POSTGRES_PORT=5432
POSTGRES_TEST_DB=clickunicap_test
POSTGRES_TEST_PORT=5433
ADMINER_PORT=8080

# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://clickunicap:clickunicap@localhost:5432/clickunicap
DATABASE_URL_TEST=postgres://clickunicap:clickunicap@localhost:5433/clickunicap_test
# Gere valores longos e aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-valor-aleatorio-longo
JWT_REFRESH_SECRET=troque-por-outro-valor-aleatorio-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
# Endereço do frontend, usado nos links dos e-mails (ex.: recuperação de senha)
WEB_URL=http://localhost:5173

# ---------- E-mail (recuperação de senha, notificações) ----------
# log    = não envia; o e-mail aparece no log da API (padrão em dev)
# resend = envio real pelo Resend. Passo a passo em docs/10-ambiente-local.md#e-mail-com-resend
MAIL_TRANSPORT=log
# Sem domínio verificado no Resend, use onboarding@resend.dev (só entrega para o e-mail dono da conta)
MAIL_FROM="ClickUNICAP <onboarding@resend.dev>"
# Chave em https://resend.com/api-keys (começa com re_). NUNCA commite a chave real.
RESEND_API_KEY=
# Anexos (Fase 2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_BYTES=10485760

# ---------- Web (apps/web) ----------
WEB_PORT=5173
VITE_API_URL=/api
VITE_ENABLE_MOCKS=false
